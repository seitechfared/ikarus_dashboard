# Figma Export Configuration
# Copy this file to .env and fill in your values

# Required: Get your Figma Personal Access Token from:
# https://www.figma.com/developers/api#access-tokens
FIGMA_ACCESS_TOKEN=change-me

# Required: Get your Figma File Key from the file URL:
# https://www.figma.com/file/{FILE_KEY}/Your-Design-Name
FIGMA_FILE_KEY=change-me

# Optional: Export format (png, svg, jpg, pdf)
FIGMA_EXPORT_FORMAT=png

# Optional: Export scale (1, 2, 3, or 4) - 2 is recommended for retina displays
FIGMA_EXPORT_SCALE=2
